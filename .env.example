# ============================================================================
# Personal Agent ProMedia Platform (.env configuration)
# Supports Local All-in-One Mode & Cross-Border Split Deployment Mode
# ============================================================================

# --- 1. Domestic Gateway Settings (:8000) ---
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
DATABASE_PATH=
# Optional shared artifact root; Claude jobs must be outside login HOME directories.
# On macOS, e.g. a private /tmp/nbppt-jobs directory. Configure both services identically.
NBPPT_JOBS_ROOT=
# Generate independently with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
NBPPT_ADMIN_API_KEY=
NBPPT_COOKIE_SECURE=true
# Set to the exact HTTPS origin in production. For local HTTP ONLY set COOKIE_SECURE=false.
NBPPT_PUBLIC_ORIGIN=http://127.0.0.1:8000
# For production PostgreSQL deployment:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/agent_billing

# DeepSeek / OpenAI-Compatible Compiler Settings (Optional: uses intelligent local compiler if empty)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- 2. Overseas / Local Worker Settings (:8001) ---
OVERSEAS_WORKER_URL=http://127.0.0.1:8001
OVERSEAS_WORKER_PUBLIC_URL=http://127.0.0.1:8001
OVERSEAS_WORKER_SECRET=

# Execution Engine Mode:
# - "auto": Automatically uses deterministic skill pipeline + Claude Code CLI when requested
# - "claude_cli": Invokes local `claude -p --output-format stream-json` headless orchestrator
# - "skill_pipeline": Directly runs the Python skill scripts (pptx-pro, codex-visual, jimeng-video)
WORKER_EXECUTION_MODE=auto
CLAUDE_BIN=
# Optional official Claude CLI PPT route (enable in BOTH gateway and worker).
# Personal subscription route: only the explicitly bound owner may use this login.
# Enable in BOTH gateway and worker; empty owner binding fails closed.
NBPPT_CLAUDE_ENABLED=false
NBPPT_CLAUDE_OWNER_USER_ID=
NBPPT_CLAUDE_MODEL=sonnet
# Required when Claude is enabled: one canonical HOME with .claude.json and credentials (0600).
# No per-job or root/worker duplicate credential copies.
NBPPT_CLAUDE_HOME=
# Required: explicit private 0700 directory shared by ALL managed callers of this account.
NBPPT_ACCOUNT_STATE_DIR=
# Native PPT validation: LibreOffice, poppler-utils, fontconfig, fonts-noto-cjk.
# Strict Linux Bash sandbox also requires bubblewrap AND socat.
NBPPT_SOFFICE=
NBPPT_PDFTOPPM=
NBPPT_PPT_PYTHON=
FFMPEG_BIN=ffmpeg

# Optional Overseas Model & Media Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
JIMENG_API_KEY=

# Trusted offline video runtime; Kokoro is opt-in (enable on the gateway only after worker validation).
NBPPT_TTS_PYTHON=
NBPPT_TTS_MODEL_DIR=
NBPPT_KOKORO_ENABLED=false
NBPPT_KOKORO_MODEL_DIR=
# Optional absolute FFmpeg path with the subtitles/libass filter.
NBPPT_FFMPEG=
