# ============================================================================
# Personal Agent ProMedia Platform (.env configuration)
# Supports Local All-in-One Mode & Cross-Border Split Deployment Mode
# ============================================================================

# --- 1. Domestic Gateway Settings (:8000) ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
DATABASE_PATH=/Users/flyignick/Code/person-work/workspace/data/platform.db
# For production PostgreSQL deployment:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/agent_billing

# DeepSeek / OpenAI-Compatible Compiler Settings (Optional: uses intelligent local compiler if empty)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- 2. Overseas / Local Worker Settings (:8001) ---
OVERSEAS_WORKER_URL=http://127.0.0.1:8001
OVERSEAS_WORKER_PUBLIC_URL=http://127.0.0.1:8001
OVERSEAS_WORKER_SECRET=super-secret-mtls-token-2026

# Execution Engine Mode:
# - "auto": Automatically uses deterministic skill pipeline + Claude Code CLI when requested
# - "claude_cli": Invokes local `claude -p --output-format stream-json` headless orchestrator
# - "skill_pipeline": Directly runs the Python skill scripts (pptx-pro, codex-visual, jimeng-video)
WORKER_EXECUTION_MODE=auto
CLAUDE_BIN=/Users/flyignick/.local/bin/claude
FFMPEG_BIN=/opt/homebrew/bin/ffmpeg

# Optional Overseas Model & Media Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
JIMENG_API_KEY=
